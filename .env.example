# Copy to .env and fill in real values.
# RESEND_API_KEY is required for the /api/contact function to send email.
# Get a key at https://resend.com/api-keys

# API key for Resend (required)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Where portfolio contact messages are delivered (required — no fallback in code)
CONTACT_TO=you@example.com

# Sender address. Must be on a verified domain in Resend.
# For testing only, Resend allows: Portfolio Contact <onboarding@resend.dev>
RESEND_FROM=Portfolio Contact <no-reply@your-domain.com>

# For production on Vercel, set these with:
#   vercel env add RESEND_API_KEY
#   vercel env add CONTACT_TO
#   vercel env add RESEND_FROM
